# GEMINI_API_KEY: Optional in FairShare Ledger (no AI calls required).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FairShare Ledger Configuration
PORT=3000
FAIRSHARE_DB_PATH="./data/fairshare.db"
FAIRSHARE_UPLOADS_DIR="./uploads"
FAIRSHARE_VERIFICATION_MODE="dev_mock"
FAIRSHARE_SESSION_SECRET=""
